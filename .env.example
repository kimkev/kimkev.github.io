# Google Analytics 4 measurement ID (public, embedded in the bundle)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase web app config (public identifiers, safe to expose)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only this Google account may read /admin
VITE_ADMIN_EMAIL=

# Used by scripts/sync-analytics.mjs only (never by the browser bundle)
GA_PROPERTY_ID=
